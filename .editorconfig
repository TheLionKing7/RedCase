# RedCase — editor/encoding enforcement (Addendum §8.5).
# The 2026-09-22 encoding cleanup (Slice 3 close-out) fixes UTF-8-misread-as-cp1252
# mojibake (â€" Â§ Â· and friends) across apps/. These rules force UTF-8 everywhere so
# the corruption class cannot silently re-enter through an editor or file write.

root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

[*.py]
charset = utf-8
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,css,md,json,yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
