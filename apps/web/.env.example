# RedCase frontend environment — copy to .env and fill in (never commit .env)


# Set to "1" to route API calls through the schema-exact dev adapters
# (lib/api/dev/*) and to bypass the auth gate on /search etc., so the redesigned
# UI is reviewable without the FastAPI backend, Supabase project, or credentials.
# In production leave unset (or "0") — the auth gate then enforces a Supabase
# session and API calls hit the live backend.
VITE_API_DEV_ADAPTER=

# FastAPI backend (VITE_API_URL takes precedence; BASE_URL remains supported).
# Set VITE_API_URL=https://api.redcase.xyz in Vercel production environments.
VITE_API_URL=
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Auth (owner ruling 3: magic link -> FastAPI verifies Supabase JWT)
VITE_SUPABASE_URL=https://jbhohcwutdqsaaxzhxra.supabase.co
VITE_SUPABASE_ANON_KEY=
